+/* Deterministic pad injection for pairing #1: the driver sets one mask and both
+ * instances feed it to the guest on the same checkpoint, so input timing cannot
+ * drift between the recompiled and interpreted sides. */
+static unsigned cosim_pad_bits = 0;
+static int      cosim_pad_active = 0;
+void cosim_set_pad_override(unsigned bits, int active)
+{
+    cosim_pad_bits = bits;
+    cosim_pad_active = active;
+}
+int cosim_get_pad_override(unsigned *bits)
+{
+    if (bits) *bits = cosim_pad_bits;
+    return cosim_pad_active;
+}
