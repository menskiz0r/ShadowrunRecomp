+/* Per-instruction timing trace: pc, cost, cumulative counters. Enabled only when
+ * GENESIS_INSN_TRACE names a file; GENESIS_INSN_TRACE_FROM/_TO bound the frames. */
+#define GEN_TRACE_RING 262144u
+typedef struct { uint32_t pc, cost, acyc; } GenTraceRec;
+static GenTraceRec s_trace_ring[GEN_TRACE_RING];
+static uint32_t s_trace_head = 0, s_trace_total = 0;
+static FILE *s_trace_file = NULL;
+static int s_trace_init = 0, s_trace_dumped = 0;
+static uint32_t s_trace_at_frame = 66;
+
+void genesis_trace_insn(uint32_t pc, uint32_t cycles)
+{
+    if (!s_trace_init) {
+        s_trace_init = 1;
+        const char *p = getenv("GENESIS_INSN_TRACE");
+        if (p && *p) s_trace_file = fopen(p, "w");
+        const char *a = getenv("GENESIS_INSN_TRACE_FRAME");
+        if (a && *a) s_trace_at_frame = (uint32_t)strtoul(a, NULL, 10);
+    }
+    if (!s_trace_file) return;
+    /* Ring keeps the most recent instructions; the dump is anchored to a shared
+     * event (reaching frame N), so both backends' dumps end at the same moment
+     * and can be aligned from the tail instead of by frame/window/counter. */
+    GenTraceRec *r = &s_trace_ring[s_trace_head & (GEN_TRACE_RING - 1u)];
+    r->pc = pc & 0xFFFFFFu;
+    r->cost = cycles;
+    r->acyc = (uint32_t)g_audio_cycle_counter;
+    s_trace_head++;
+    if (s_trace_total < GEN_TRACE_RING) s_trace_total++;
+    if (!s_trace_dumped && g_frame_count >= s_trace_at_frame) {
+        uint32_t n = s_trace_total, start = s_trace_head - n;
+        fprintf(s_trace_file, "# frame %u ring %u\n", (unsigned)g_frame_count, n);
+        for (uint32_t k = 0; k < n; k++) {
+            GenTraceRec *q = &s_trace_ring[(start + k) & (GEN_TRACE_RING - 1u)];
+            fprintf(s_trace_file, "%06X %u %u\n", (unsigned)q->pc, q->cost, q->acyc);
+        }
+        fclose(s_trace_file);
+        s_trace_file = NULL;
+        s_trace_dumped = 1;
+    }
+}
