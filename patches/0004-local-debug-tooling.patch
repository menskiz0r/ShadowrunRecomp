+/* TEMPORARY: periodic framebuffer capture for hands-on sessions.
+ * DSH_AUTOSHOT=<dir> writes <dir>/f%05u.ppm every DSH_AUTOSHOT_EVERY frames. */
+static const char *s_autoshot_dir = NULL;   /* set by --autoshot-dir */
+static int s_autoshot_every = 30;
+static void dsh_autoshot(uint32_t frame)
+{
+    static int every = -1;
+    const char *dir = s_autoshot_dir ? s_autoshot_dir : getenv("DSH_AUTOSHOT");
+    if (!dir || !*dir) return;
+    if (every < 0) {
+        const char *e = getenv("DSH_AUTOSHOT_EVERY");
+        every = s_autoshot_every;
+        if (!s_autoshot_dir && e && *e) every = atoi(e);
+        if (every <= 0) every = 30;
+    }
+    if (frame % (uint32_t)every) return;
+    char path[512];
+    snprintf(path, sizeof path, "%s/f%05u.ppm", dir, frame);
+    FILE *f = fopen(path, "wb");
+    if (!f) return;
+    fprintf(f, "P6\n%d %d\n255\n", s_screen_width, s_screen_height);
+    for (int y = 0; y < s_screen_height; y++) {
+        const uint32_t *row = s_framebuf + (size_t)y * MAX_SCREEN_WIDTH;
+        for (int x = 0; x < s_screen_width; x++) {
+            uint32_t px = row[x];
+            unsigned char rgb[3] = { (unsigned char)((px >> 16) & 0xFF),
+                                     (unsigned char)((px >> 8) & 0xFF),
+                                     (unsigned char)(px & 0xFF) };
+            fwrite(rgb, 1, 3, f);
+        }
+    }
+    fclose(f);
+}
