+/* TEMPORARY: dump the reverse-debug block ring at a chosen frame. */
+static void dsh_blockring_dump(uint32_t frame)
+{
+    static int done = 0;
+    const char *at = getenv("DSH_BLOCKRING_AT");
+    if (!at || !*at || done) return;
+    unsigned long want = strtoul(at, NULL, 0);
+    if (frame < want) return;
+    done = 1;
+    const char *path = getenv("DSH_BLOCKRING");
+    if (!path || !*path) return;
+    uint32_t buf[512]; uint32_t total = 0;
+    unsigned n = crash_report_recent_blocks(buf, 512, &total);
+    FILE *f = fopen(path, "w");
+    if (!f) return;
+    fprintf(f, "# frame %u total %u\n", frame, total);
+    for (unsigned i = 0; i < n; i++) fprintf(f, "%06X\n", buf[i]);
+    fclose(f);
+}
