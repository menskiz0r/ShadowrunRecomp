     }
     g_snd_frame++;   /* [SND-TRACE] */
+
+    if (phase_log) {
+        double t1 = genesis_now_us();
+        fprintf(stderr, "[PH] f=%lu total=%.0f 68k=%.0f z80=%.0f vdp=%.0f other=%.0f\n",
+                g_snd_frame, t1 - phase_t0, phase_68k, phase_z80, phase_vdp,
+                (t1 - phase_t0) - phase_68k - phase_z80 - phase_vdp);
+    }
 }
 
 void machine_run_frame(GenesisScanlineSink sink, void *user)
 {
     machine_run_frame_ex(sink, user, NULL);
 }
