+/* TEMPORARY: dump the reverse-debug block ring at a chosen frame. */
+static void dsh_blockring_dump(uint32_t frame)
+{
+    static int done = 0;
+    const char *at = getenv("DSH_BLOCKRING_AT");
+    if (!at || !*at || done) return;
+    unsigned long want = strtoul(at, NULL, 0);
+    if (frame < want) return;
+    done = 1;
+    const char *path = getenv("DSH_BLOCKRING");
+    if (!path || !*path) return;
+    uint32_t buf[512]; uint32_t total = 0;
+    unsigned n = crash_report_recent_blocks(buf, 512, &total);
+    FILE *f = fopen(path, "w");
+    if (!f) return;
+    fprintf(f, "# frame %u total %u\n", frame, total);
+    for (unsigned i = 0; i < n; i++) fprintf(f, "%06X\n", buf[i]);
+    fclose(f);
+}
+
+/* TEMPORARY: ring-buffered work-RAM snapshots for hands-on sessions.
+ * --autodump-ram-dir <dir> [--autodump-ram-every N] [--autodump-ram-keep K]
+ * Writes <dir>/r%06u.ram every N frames and deletes snapshots older than K. */
+static const char *s_autodump_ram_dir = NULL;
+static int s_autodump_ram_every = 30;
+static int s_autodump_ram_keep = 400;
+static void dsh_autodump_ram(uint32_t frame)
+{
+    if (!s_autodump_ram_dir) return;
+    if (frame % (uint32_t)s_autodump_ram_every) return;
+    char path[600];
+    snprintf(path, sizeof path, "%s/r%06u.ram", s_autodump_ram_dir, frame);
+    FILE *f = fopen(path, "wb");
+    if (!f) return;
+    extern uint8_t g_ram[0x10000];
+    fwrite(g_ram, 1, 0x10000, f);
+    fclose(f);
+    uint32_t old = frame - (uint32_t)(s_autodump_ram_every * s_autodump_ram_keep);
+    snprintf(path, sizeof path, "%s/r%06u.ram", s_autodump_ram_dir, old);
+    remove(path);
+}
