+/* Per-instruction timing trace: pc, cost, cumulative counters. Enabled only when
+ * GENESIS_INSN_TRACE names a file; GENESIS_INSN_TRACE_FROM/_TO bound the frames. */
+void genesis_trace_insn(uint32_t pc, uint32_t cycles)
+{
+    static FILE *f = NULL;
+    static int init = 0;
+    static uint32_t from = 0, to = ~0u;
+    if (!init) {
+        init = 1;
+        const char *p = getenv("GENESIS_INSN_TRACE");
+        if (p && *p) {
+            f = fopen(p, "w");
+            const char *a = getenv("GENESIS_INSN_TRACE_FROM");
+            const char *b = getenv("GENESIS_INSN_TRACE_TO");
+            if (a && *a) from = (uint32_t)strtoul(a, NULL, 0);
+            if (b && *b) to = (uint32_t)strtoul(b, NULL, 0);
+        }
+    }
+    if (!f || g_frame_count < from || g_frame_count > to) return;
+    fprintf(f, "%u %06X %u %u %u\n", (unsigned)g_frame_count, (unsigned)(pc & 0xFFFFFFu),
+            cycles, (unsigned)g_audio_cycle_counter, (unsigned)g_native_insn_count);
+}
